/**
 * Gemini AI Integration Service
 * Communicates with Google's Gemini models for email reply generation.
 */

var GEMINI_MODEL = 'gemini-1.5-flash';

/**
 * Generates an email reply using Gemini API
 * @param {Object} params
 * @param {string} params.emailBody - The incoming email message content
 * @param {string} params.sender - The sender of the incoming email
 * @param {string} params.subject - The subject of the email
 * @param {string} params.tone - Selected tone (professional, friendly, casual, decline, acknowledge)
 * @param {string} params.customNote - Extra user notes or instructions
 * @param {string} params.language - Desired output language (auto, en, bn)
 * @return {string} The generated reply body
 */
function generateEmailReply(params) {
  var apiKey = getApiKey();
  if (!apiKey) {
    throw new Error('API_KEY_MISSING');
  }

  var cleanBody = cleanEmailBody(params.emailBody);
  var prompt = buildPrompt({
    emailBody: cleanBody,
    sender: params.sender || '',
    subject: params.subject || '',
    tone: params.tone || 'professional',
    customNote: params.customNote || '',
    language: params.language || 'auto',
    signOff: getUserSignOff()
  });

  var endpoint = 'https://generativelanguage.googleapis.com/v1beta/models/' +
                 GEMINI_MODEL + ':generateContent?key=' + encodeURIComponent(apiKey);

  var payload = {
    contents: [
      {
        parts: [
          { text: prompt }
        ]
      }
    ],
    generationConfig: {
      temperature: 0.6,
      topK: 40,
      topP: 0.95,
      maxOutputTokens: 1024
    }
  };

  var options = {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };

  var response = UrlFetchApp.fetch(endpoint, options);
  var statusCode = response.getResponseCode();
  var responseText = response.getContentText();

  if (statusCode !== 200) {
    try {
      var errJson = JSON.parse(responseText);
      var errMsg = (errJson.error && errJson.error.message) ? errJson.error.message : responseText;
      throw new Error('Gemini API Error (' + statusCode + '): ' + errMsg);
    } catch (e) {
      throw new Error('Gemini API Error: ' + responseText);
    }
  }

  var result = JSON.parse(responseText);
  if (result.candidates && result.candidates.length > 0 &&
      result.candidates[0].content && result.candidates[0].content.parts &&
      result.candidates[0].content.parts.length > 0) {
    var generatedText = result.candidates[0].content.parts[0].text;
    return formatReplyForGmail(generatedText);
  }

  throw new Error('No response was generated by the AI model.');
}

/**
 * Builds instructions and prompt for Gemini
 */
function buildPrompt(data) {
  var toneInstructions = {
    professional: 'Tone: Professional, polite, clear, respectful, and business-ready.',
    friendly: 'Tone: Warm, friendly, approachable, conversational, yet courteous.',
    quick: 'Tone: Concise, direct, efficient (2-4 sentences max), getting straight to the point.',
    decline: 'Tone: Respectfully decline the request or offer, expressing sincere gratitude while setting clear, polite boundaries.',
    accept: 'Tone: Positively agree, accept the request/meeting, expressing enthusiasm and readiness for next steps.'
  };

  var selectedToneDesc = toneInstructions[data.tone] || toneInstructions.professional;

  var langInstruction = '';
  if (data.language === 'bn') {
    langInstruction = 'Write the reply in natural, polished Bengali (বাংলা).';
  } else if (data.language === 'en') {
    langInstruction = 'Write the reply in clean, fluent English.';
  } else {
    langInstruction = 'Match the primary language of the incoming email (if written in Bengali, reply in Bengali; if in English, reply in English).';
  }

  var signOffInstruction = data.signOff 
    ? 'End the email with this sign-off: "' + data.signOff + '"'
    : 'Do not invent or add an imaginary full name if unsure; keep sign-off simple (e.g., "Best regards,").';

  return 'You are an elite, highly effective executive email assistant.\n' +
    'Your task is to write a well-crafted email reply to the incoming email provided below.\n\n' +
    'CRITICAL GUIDELINES:\n' +
    '1. ' + selectedToneDesc + '\n' +
    '2. ' + langInstruction + '\n' +
    '3. ' + signOffInstruction + '\n' +
    '4. Output ONLY the reply email body text. Do NOT include markdown code blocks (no ```), do not include extra commentary, subject line, or meta descriptions.\n' +
    '5. Address the key points of the incoming email accurately and thoughtfully.\n' +
    (data.customNote ? '6. CRITICAL USER INSTRUCTION / CUSTOM NOTE: ' + data.customNote + '\n' : '') +
    '\n' +
    '--- INCOMING EMAIL DETAILS ---\n' +
    'Sender: ' + (data.sender || 'Unknown') + '\n' +
    'Subject: ' + (data.subject || 'No Subject') + '\n' +
    'Message Content:\n' +
    data.emailBody + '\n' +
    '--- END OF INCOMING EMAIL ---\n\n' +
    'Provide the reply email now:';
}

/**
 * Cleans incoming email body from unwanted clutter
 */
function cleanEmailBody(body) {
  if (!body) return '';
  
  // Replace HTML tags with spaces/newlines if HTML
  var text = body.replace(/<style[^>]*>[\s\S]*?<\/style>/gi, '')
                 .replace(/<script[^>]*>[\s\S]*?<\/script>/gi, '')
                 .replace(/<br\s*[\/]?>/gi, '\n')
                 .replace(/<\/p>/gi, '\n\n')
                 .replace(/<[^>]+>/g, ' ');

  // Remove excessive whitespace & quoted blocks
  text = text.replace(/&nbsp;/g, ' ')
             .replace(/&amp;/g, '&')
             .replace(/&lt;/g, '<')
             .replace(/&gt;/g, '>');

  // Trim to first 4000 characters to prevent huge token consumption
  if (text.length > 4000) {
    text = text.substring(0, 4000) + '... [truncated]';
  }

  return text.trim();
}

/**
 * Formats generated text into clean HTML for Gmail draft insertion
 */
function formatReplyForGmail(text) {
  if (!text) return '';

  // Strip accidental markdown backticks
  text = text.replace(/^```[a-z]*\n?/i, '').replace(/\n?```$/i, '').trim();

  // Convert newlines to HTML breaks for proper Gmail draft rendering
  var html = text.replace(/\n\n+/g, '<br><br>').replace(/\n/g, '<br>');
  return html;
}
